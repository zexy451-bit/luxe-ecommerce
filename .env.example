# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin (must match auth.users email after signup)
ADMIN_EMAIL=

# Store branding (defaults — overridable in admin Settings)
STORE_NAME=Luxe
STORE_EMAIL=hello@luxe.com
STORE_PHONE=+1 555 0100
STORE_ADDRESS=123 Madison Ave, New York, NY

# Resend (transactional email)
RESEND_API_KEY=
# e.g. "Luxe <orders@yourdomain.com>" once domain verified, or onboarding@resend.dev for testing
RESEND_FROM=Luxe <onboarding@resend.dev>
